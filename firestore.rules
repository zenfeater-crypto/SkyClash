rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // Exact Owner Admin identification using server-side role on authenticated user doc
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (userExists(request.auth.uid) && getUserData(request.auth.uid).role == 'admin')
      );
    }

    function isOfficer() {
      return isSignedIn() && (
        userExists(request.auth.uid) && getUserData(request.auth.uid).role == 'officer'
      );
    }

    function isStaff() {
      return isAdmin() || isOfficer();
    }

    function isTrusted() {
      return isSignedIn() && (
        isStaff() ||
        (userExists(request.auth.uid) && getUserData(request.auth.uid).role == 'trusted')
      );
    }

    // Granular JMD permissions helpers
    function hasCallerPermission(permName) {
      return isSignedIn() && userExists(request.auth.uid) &&
        'permissions' in getUserData(request.auth.uid) &&
        permName in getUserData(request.auth.uid).permissions &&
        getUserData(request.auth.uid).permissions[permName] == true;
    }

    function canCallerChangeValues() {
      return isAdmin() || hasCallerPermission('changeValues');
    }

    function canCallerBanUnban() {
      return isAdmin() || hasCallerPermission('banUnban');
    }

    function canCallerDeleteChats() {
      return isAdmin() || isOfficer() || hasCallerPermission('deleteChats');
    }

    function canCallerChooseTrusted() {
      return isAdmin() || hasCallerPermission('chooseTrusted');
    }

    // Temporary & permanent ban enforcement
    function isUserBanned(userId) {
      return userExists(userId) && (
        (('banned' in getUserData(userId) && getUserData(userId).banned == true) ||
         ('isBanned' in getUserData(userId) && getUserData(userId).isBanned == true)) &&
        (!('banType' in getUserData(userId)) || getUserData(userId).banType == 'permanent' ||
         (('bannedUntil' in getUserData(userId)) && getUserData(userId).bannedUntil != null && request.time.toMillis() < getUserData(userId).bannedUntil))
      );
    }

    // Temporary & permanent mute enforcement
    function isUserMuted(userId) {
      return userExists(userId) && (
        (('muted' in getUserData(userId) && getUserData(userId).muted == true) ||
         ('isMuted' in getUserData(userId) && getUserData(userId).isMuted == true)) &&
        (!('muteType' in getUserData(userId)) || getUserData(userId).muteType == 'permanent' ||
         (('mutedUntil' in getUserData(userId)) && getUserData(userId).mutedUntil != null && request.time.toMillis() < getUserData(userId).mutedUntil))
      );
    }

    // Validate 24-hour daily reward cooldown and prevent coin balance cheating
    function isValidOwnerDailyRewardUpdate(userId) {
      return (
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastRewardClaimTimestamp'])) ?
          (!('coinBalance' in request.resource.data) || !('coinBalance' in resource.data) || request.resource.data.coinBalance <= resource.data.coinBalance) :
          (
            // Must wait at least 24 hours (86,400,000 ms) from previous claim
            (!('lastRewardClaimTimestamp' in resource.data) || request.time.toMillis() >= resource.data.lastRewardClaimTimestamp + 86400000) &&
            // Claim timestamp must match or precede current server time
            request.resource.data.lastRewardClaimTimestamp <= request.time.toMillis() + 60000 &&
            // Max reward increment is 1000 coins (schedule max is 500 or fallback 1000)
            (!('coinBalance' in resource.data) || request.resource.data.coinBalance <= resource.data.coinBalance + 1000)
          )
      ) &&
      (!('coinBalance' in request.resource.data) || request.resource.data.coinBalance >= 0);
    }

    // USERS COLLECTION (Hierarchy: Admin [Strike Owner], Officer, Trusted, User, JMD)
    match /users/{userId} {
      allow read: if isSignedIn();

      // Create: Normal users can only create role 'user'; Strike account can bootstrap as 'admin'
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'user' ||
        (request.resource.data.role == 'admin' && (
          exists(/databases/$(database)/documents/usernames/strike) ?
            get(/databases/$(database)/documents/usernames/strike).data.uid == userId :
            (('normalizedUsername' in request.resource.data && request.resource.data.normalizedUsername == 'strike') ||
             ('username' in request.resource.data && request.resource.data.username == 'strike'))
        ))
      );

      // Update:
      // 1. Regular user can only edit cosmetic profile fields (name, bio, profilePhoto, avatarUrl) & chat cooldown
      //    Cannot modify role, permissions, uid, createdAt, ban, or mute status.
      // 2. Self bootstrap for Strike account: sets role to 'admin'
      // 3. Officer can mute/unmute non-staff users only
      // 4. JMD with Ban/Unban permission can temporary/permanent ban or unban non-admin users
      // 5. JMD with Choose Trusted permission can assign/remove Trusted role on normal users
      // 6. Only the protected Owner Admin can grant/revoke roles & manage JMD permissions
      //    - Exactly one admin: No second admin can be created (target role cannot become 'admin' if not already 'admin')
      //    - Admin cannot be demoted (existing admin must remain 'admin')
      allow update: if (
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'bio', 'profilePhoto', 'avatarUrl', 'profileSetupComplete', 'lastWorldChatAt', 'lastChatMessageNorm', 'sameMessageCount',
          'coinBalance', 'loginStreak', 'lastRewardClaimDate', 'lastRewardClaimTimestamp', 'rewardCycleDay', 'lastChallengePostAt',
          'profileFrameId', 'textFrameId', 'rewardHistory', 'lastTradePostAt'
        ]) &&
         (!('role' in resource.data) || request.resource.data.role == resource.data.role) &&
         (!('sameMessageCount' in request.resource.data) || request.resource.data.sameMessageCount <= 2) &&
         isValidOwnerDailyRewardUpdate(userId)) ||
        (isOwner(userId) && request.resource.data.role == 'admin' && (
          exists(/databases/$(database)/documents/usernames/strike) ?
            get(/databases/$(database)/documents/usernames/strike).data.uid == userId :
            (('normalizedUsername' in resource.data && resource.data.normalizedUsername == 'strike') ||
             ('username' in resource.data && resource.data.username == 'strike'))
        )) ||
        (isOfficer() && resource.data.role != 'admin' && resource.data.role != 'officer' && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['muted', 'isMuted', 'muteType', 'mutedUntil', 'mutedBy', 'muteReason'])) ||
        (canCallerBanUnban() && request.auth.uid != userId && resource.data.role != 'admin' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'banned', 'isBanned', 'banType', 'bannedUntil', 'banReason', 'bannedBy', 'bannedAt'
         ])) ||
        (canCallerChooseTrusted() && request.auth.uid != userId &&
         resource.data.role != 'admin' && resource.data.role != 'officer' && resource.data.role != 'jmd' &&
         (request.resource.data.role == 'trusted' || (resource.data.role == 'trusted' && request.resource.data.role == 'user')) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])) ||
        (isAdmin() && (
          (resource.data.role != 'admin' && request.resource.data.role != 'admin') ||
          (resource.data.role == 'admin' && request.resource.data.role == 'admin')
        ))
      );

      // Delete: Only Admin can delete non-admin records; Admin is permanent and cannot be deleted
      allow delete: if isAdmin() && !isOwner(userId) && resource.data.role != 'admin';
    }

    // USERNAMES COLLECTION (Unique Handle Registry)
    match /usernames/{normalizedUsername} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false; // Usernames are permanent/immutable
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ITEMS COLLECTION (Skyblock Values Catalog - Swords, Armour, Accessories / Items)
    match /items/{itemId} {
      allow read: if true; // Public catalog
      // Protected Owner Admin can add or remove items
      allow create, delete: if isAdmin();
      // Owner Admin or JMD with 'changeValues' permission can edit existing values
      allow update: if canCallerChangeValues() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.value is number &&
        request.resource.data.value >= 0;
    }

    // PETS COLLECTION (Skyblock Pet Values Catalog)
    match /pets/{petId} {
      allow read: if true; // Public pet catalog
      // Protected Owner Admin can add or remove pets
      allow create, delete: if isAdmin();
      // Owner Admin or JMD with 'changeValues' permission can edit existing values
      allow update: if canCallerChangeValues() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
    }

    // VALUE AUDIT LOGS (Immutable History of Price Changes)
    match /valueAudit/{auditId} {
      allow read: if isStaff() || canCallerChangeValues();
      allow create: if (isStaff() || canCallerChangeValues()) && request.resource.data.changedByUid == request.auth.uid;
      allow update, delete: if false; // Audit logs can never be manipulated
    }

    // PERMISSION AUDIT LOGS (Immutable Owner Admin Records for JMD Permissions)
    match /permissionAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false; // Audit logs can never be manipulated
    }

    // MEMBERSHIP AUDIT LOGS (Immutable Owner Admin Records for Membership Changes)
    match /membershipAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false; // Audit logs can never be manipulated
    }

    // MODERATION HISTORY (Immutable Audit of Staff & JMD Actions)
    match /moderationHistory/{historyId} {
      allow read: if isStaff() || canCallerBanUnban() || canCallerDeleteChats() || canCallerChooseTrusted();
      allow create: if (isStaff() || canCallerBanUnban() || canCallerDeleteChats() || canCallerChooseTrusted()) && request.resource.data.performedByUid == request.auth.uid;
      allow update, delete: if false; // Moderation logs can never be altered
    }

    // REPORTS COLLECTION (Role-Based Moderation Queue — STRICTLY Officer & Trusted reports)
    match /reports/{reportId} {
      // Read: Only Owner Admin and Officers can access reports
      allow read: if isAdmin() || isOfficer();

      // Create: ONLY verified Officer or Trusted users can create reports.
      // Server-side validation strictly verifies that the user is not banned,
      // and their reporterRole strictly matches their protected role in /users/{userId}.
      allow create: if isSignedIn() &&
        request.resource.data.reporterUid == request.auth.uid &&
        !isUserBanned(request.auth.uid) &&
        userExists(request.auth.uid) &&
        (
          (getUserData(request.auth.uid).role == 'officer' && request.resource.data.reporterRole == 'officer') ||
          (getUserData(request.auth.uid).role == 'trusted' && request.resource.data.reporterRole == 'trusted')
        ) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0;

      // Update: Only Staff (Owner Admin & Officer) can review and update report status
      allow update: if isStaff() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'actionTaken', 'reviewedByUid', 'reviewedByUsername', 'reviewedAt'
        ]);

      // Delete: Only Owner Admin can delete report records
      allow delete: if isAdmin();
    }

    // WORLD CHAT MESSAGES (Restricted to signed-in users, 30m expiry, 7s backend cooldown, max 300 chars, max 2 duplicates)
    match /worldMessages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.resource.data.senderUid == request.auth.uid &&
        !isUserBanned(request.auth.uid) &&
        !isUserMuted(request.auth.uid) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 300 &&
        request.resource.data.createdAt is number &&
        request.resource.data.expiresAt is number &&
        request.resource.data.expiresAt >= request.resource.data.createdAt + 1740000 &&
        request.resource.data.expiresAt <= request.resource.data.createdAt + 1860000 &&
        (!('sameMessageCount' in request.resource.data) || request.resource.data.sameMessageCount <= 2) &&
        (
          !userExists(request.auth.uid) ||
          !('lastWorldChatAt' in getUserData(request.auth.uid)) ||
          getUserData(request.auth.uid).lastWorldChatAt == null ||
          request.time.toMillis() >= getUserData(request.auth.uid).lastWorldChatAt + 7000
        );
      allow update, delete: if isStaff() || (canCallerDeleteChats() && (!('senderRole' in resource.data) || resource.data.senderRole != 'admin') && (!('senderUsername' in resource.data) || resource.data.senderUsername != 'strike'));
    }

    // WORLD CHAT GROUPS
    match /worldChatGroups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.isAutoCreated == true);
      allow update: if isSignedIn() && (!isUserBanned(request.auth.uid) || isAdmin());
      allow delete: if isAdmin();
    }

    // WORLD CHAT PRESENCE (Active player tracking for <= 75 active users capacity)
    match /worldChatPresence/{presenceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == presenceId;
    }

    // WORLD CHAT SETTINGS (Auto Groups toggle, managed by Owner Admin)
    match /worldChatSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // TRADE POSTS (Community Trade Feed - Restricted to active signed-in users with 7-min cooldown)
    match /trade_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.posterUid == request.auth.uid &&
        !isUserBanned(request.auth.uid) &&
        !isUserMuted(request.auth.uid) &&
        request.resource.data.createdAt is number &&
        request.resource.data.expiresAt is number &&
        request.resource.data.expiresAt > request.time.toMillis() &&
        (
          !userExists(request.auth.uid) ||
          !('lastTradePostAt' in getUserData(request.auth.uid)) ||
          getUserData(request.auth.uid).lastTradePostAt == null ||
          request.time.toMillis() >= getUserData(request.auth.uid).lastTradePostAt + 418000
        );
      allow update: if isSignedIn() && (
        (resource.data.posterUid == request.auth.uid && request.resource.data.posterUid == resource.data.posterUid && !isUserBanned(request.auth.uid) && !isUserMuted(request.auth.uid)) ||
        isStaff()
      );
      allow delete: if isSignedIn() && (
        resource.data.posterUid == request.auth.uid ||
        isStaff() ||
        (canCallerDeleteChats() && (!('posterRole' in resource.data) || resource.data.posterRole != 'admin') && (!('posterUsername' in resource.data) || resource.data.posterUsername != 'strike'))
      );
    }

    // PRIVATE CONVERSATIONS & MESSAGES
    match /conversations/{convId} {
      allow read: if isSignedIn() && (
        convId.matches('.*' + request.auth.uid + '.*') ||
        (resource != null && 'participants' in resource.data && resource.data.participants.hasAny([request.auth.uid]))
      );
      allow create: if isSignedIn() && !isUserBanned(request.auth.uid) && !isUserMuted(request.auth.uid) && (
        convId.matches('.*' + request.auth.uid + '.*') ||
        (request.resource != null && 'participants' in request.resource.data && request.resource.data.participants.hasAny([request.auth.uid]))
      );
      allow update: if isSignedIn() && !isUserBanned(request.auth.uid) && !isUserMuted(request.auth.uid) && (
        convId.matches('.*' + request.auth.uid + '.*') ||
        (resource != null && 'participants' in resource.data && resource.data.participants.hasAny([request.auth.uid])) ||
        (request.resource != null && 'participants' in request.resource.data && request.resource.data.participants.hasAny([request.auth.uid]))
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          convId.matches('.*' + request.auth.uid + '.*') ||
          !exists(/databases/$(database)/documents/conversations/$(convId)) ||
          get(/databases/$(database)/documents/conversations/$(convId)).data.participants.hasAny([request.auth.uid])
        );
        allow create: if isSignedIn() &&
          request.resource.data.senderUid == request.auth.uid &&
          !isUserBanned(request.auth.uid) &&
          !isUserMuted(request.auth.uid) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 && (
            convId.matches('.*' + request.auth.uid + '.*') ||
            !exists(/databases/$(database)/documents/conversations/$(convId)) ||
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants.hasAny([request.auth.uid])
          );
        allow update, delete: if isStaff() || (isSignedIn() && resource.data.senderUid == request.auth.uid);
      }
    }

    // FRIEND REQUESTS
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        !isUserBanned(request.auth.uid) &&
        !isUserMuted(request.auth.uid);
      allow update, delete: if isSignedIn() && (
        resource.data.receiverUid == request.auth.uid ||
        resource.data.senderUid == request.auth.uid
      );
    }

    // FRIENDSHIPS
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && resource.data.users.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && request.resource.data.users.hasAny([request.auth.uid]) && !isUserBanned(request.auth.uid);
      allow update, delete: if isSignedIn() && resource.data.users.hasAny([request.auth.uid]);
    }

    // FAVORITES
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && !isUserBanned(request.auth.uid);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // TRADE HISTORY
    match /tradeHistory/{tradeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && !isUserBanned(request.auth.uid);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // USER BLOCKS & LOCAL MUTES
    match /userBlocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
    }

    // SKYBLOCK WARS & BEDWARS - GANGS
    match /wars_gangs/{gangId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.leaderUid == request.auth.uid && 
        request.resource.data.leaderUid == resource.data.leaderUid
      ) || (
        // Allow a normal member to leave the gang by removing themselves
        isSignedIn() &&
        resource.data.leaderUid != request.auth.uid &&
        resource.data.memberUids.hasAny([request.auth.uid]) &&
        !request.resource.data.memberUids.hasAny([request.auth.uid]) &&
        request.resource.data.leaderUid == resource.data.leaderUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids', 'updatedAt'])
      );

      // GANG CHAT SUBCOLLECTION (30-Minute Ephemeral Messages)
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          !isUserBanned(request.auth.uid) &&
          !isUserMuted(request.auth.uid) &&
          request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderUid == request.auth.uid);
      }
    }

    // GANG INVITATIONS
    match /gangInvitations/{inviteId} {
      allow read: if isSignedIn() && (
        resource.data.receiverUid == request.auth.uid || 
        resource.data.senderUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        !isUserBanned(request.auth.uid) &&
        !isUserMuted(request.auth.uid) &&
        request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.receiverUid == request.auth.uid || 
        resource.data.senderUid == request.auth.uid ||
        isAdmin()
      );
    }

    // GANG MEMBERSHIPS (ONE GANG AT A TIME LOCK)
    match /gangMemberships/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (request.resource.data.gangId != null && exists(/databases/$(database)/documents/wars_gangs/$(request.resource.data.gangId)) && get(/databases/$(database)/documents/wars_gangs/$(request.resource.data.gangId)).data.leaderUid == request.auth.uid)
      );
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (exists(/databases/$(database)/documents/wars_gangs/$(resource.data.gangId)) && get(/databases/$(database)/documents/wars_gangs/$(resource.data.gangId)).data.leaderUid == request.auth.uid)
      );
    }

    // GANG APPLICATIONS
    match /gangApplications/{appId} {
      allow read: if isSignedIn() && (
        resource.data.applicantUid == request.auth.uid || 
        resource.data.leaderUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        !isUserBanned(request.auth.uid) &&
        request.resource.data.applicantUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.applicantUid == request.auth.uid || 
        resource.data.leaderUid == request.auth.uid ||
        isAdmin()
      );
    }

    // SKYBLOCK WARS - ANNOUNCEMENTS (Admin Only)
    match /wars_announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // SKYBLOCK WARS - LEADERBOARD (Admin Only)
    match /wars_leaderboard/{entryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // SKYBLOCK WARS - MATCHINGS
    match /wars_matchings/{matchingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        !isUserBanned(request.auth.uid) &&
        request.resource.data.leaderUid == request.auth.uid;
      allow update, delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.leaderUid == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'challengerGangId', 'challengerGangName'])
        )
      );
    }

    // SKYBLOCK WARS - LIVE WARS (Admin Only)
    match /wars_live/{liveMatchId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // FRAME COLLECTION (Global registry of Profile Frames & Text Frames - Owner Admin only writes, all signed-in read)
    match /frameCollection/{frameId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // FRAME AUDIT LOGS (Immutable Owner Admin Records for Frame Assignments)
    match /frameAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false; // Audit logs can never be manipulated
    }

    // ADMIN FAVORITES (Owner Admin favorite frames)
    match /adminFavorites/{favId} {
      allow read, write: if isAdmin();
    }

    // MID MAN POSTS (Owner Admin-Only Create/Update/Delete, Public Read)
    match /midman_posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() && 
        request.resource.data.createdByAdminUid == request.auth.uid &&
        (request.resource.data.category == 'account_trades' || request.resource.data.category == 'upi_trade') &&
        request.resource.data.appUsername is string &&
        request.resource.data.gameUsername is string &&
        request.resource.data.description is string &&
        request.resource.data.charges is string;
      allow update: if isAdmin() &&
        (request.resource.data.category == 'account_trades' || request.resource.data.category == 'upi_trade') &&
        request.resource.data.appUsername is string &&
        request.resource.data.gameUsername is string &&
        request.resource.data.description is string &&
        request.resource.data.charges is string;
      allow delete: if isAdmin();
    }

    // SOLO / DUO CHALLENGES (12-hour expiry, 250-coin posting fee, Owner Admin deletion)
    match /solo_duo_challenges/{challengeId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        !isUserBanned(request.auth.uid) &&
        request.resource.data.creatorUid == request.auth.uid &&
        (request.resource.data.gameType == 'skyblock' || request.resource.data.gameType == 'bedwars') &&
        (request.resource.data.matchType == 'solo_vs_solo' || request.resource.data.matchType == 'duo_vs_duo') &&
        request.resource.data.gameUsername is string &&
        request.resource.data.description is string &&
        request.resource.data.createdAt is number &&
        request.resource.data.expiresAt is number;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // TOURNAMENTS (Owner Admin Strike manages all; Authenticated players can self-register if slots open)
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isAdmin() &&
        request.resource.data.name is string &&
        (request.resource.data.category == 'skyblock' || request.resource.data.category == 'bedwars') &&
        request.resource.data.maxPlayers is number;
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount', 'registeredUserUids', 'updatedAt']) &&
        request.resource.data.registeredCount == (('registeredCount' in resource.data) ? resource.data.registeredCount + 1 : 1) &&
        request.resource.data.registeredCount <= resource.data.maxPlayers &&
        request.auth.uid in request.resource.data.registeredUserUids &&
        (!('registeredUserUids' in resource.data) || !(request.auth.uid in resource.data.registeredUserUids))
      );
      allow delete: if isAdmin();
    }

    // TOURNAMENT REGISTRATIONS (Owner Admin Strike or authenticated players self-registering; Public read)
    match /tournament_registrations/{regId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() &&
        regId == request.resource.data.tournamentId + '_' + request.auth.uid &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.tournamentId is string &&
        exists(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId))
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}

